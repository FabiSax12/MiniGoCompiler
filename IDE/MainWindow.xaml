<Window x:Class="IDE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:IDE"
        mc:Ignorable="d"
        Title="MiniGo IDE" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="F6" Command="{x:Static local:MainWindow.BuildCommand}" />
        <KeyBinding Key="F5" Command="{x:Static local:MainWindow.RunCommand}" />
        <KeyBinding Key="S"  Modifiers="Ctrl"       Command="{x:Static local:MainWindow.SaveCommand}" />
        <KeyBinding Key="O"  Modifiers="Ctrl+Shift" Command="{x:Static local:MainWindow.OpenFolderCommand}" />
    </Window.InputBindings>
    <Window.Resources>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="#2D2D30" Foreground="#CCCCCC">
            <MenuItem Header="_File" Foreground="#CCCCCC">
                <MenuItem Header="_Open Folder..."
                          Command="{x:Static local:MainWindow.OpenFolderCommand}"
                          InputGestureText="Ctrl+Shift+O"
                          Foreground="#000000" Background="#FFFFFF" />
                <MenuItem x:Name="menuCloseFolder" Header="_Close Folder"
                          Click="OnCloseFolderClick"
                          IsEnabled="False"
                          Foreground="#000000" Background="#FFFFFF" />
                <MenuItem x:Name="menuSave" Header="_Save"
                          Command="{x:Static local:MainWindow.SaveCommand}"
                          InputGestureText="Ctrl+S"
                          IsEnabled="False"
                          Foreground="#000000" Background="#FFFFFF" />
                <MenuItem Header="E_xit" Click="OnExitClick" Foreground="#000000" Background="#FFFFFF" />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="#2D2D30" BorderBrush="#3C3C3C" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Horizontal" Margin="6,4">
                <Button x:Name="buildButton"
                        Content="⚙ Build"
                        Click="OnBuildClick"
                        ToolTip="Build current file (F6)"
                        Padding="14,5"
                        Margin="0,0,6,0"
                        Background="#0E639C"
                        Foreground="White"
                        BorderThickness="0"
                        FontFamily="Consolas"
                        FontSize="13"
                        Cursor="Hand" />
                <Button x:Name="stopButton"
                        Content="⏹ Stop"
                        Click="OnStopClick"
                        ToolTip="Stop current build"
                        Padding="14,5"
                        Margin="0,0,6,0"
                        Background="#D13438"
                        Foreground="White"
                        BorderThickness="0"
                        FontFamily="Consolas"
                        FontSize="13"
                        Cursor="Hand"
                        IsEnabled="False"
                        Visibility="Hidden" />
                <Button x:Name="runButton"
                        Content="▶ Run"
                        Click="OnRunClick"
                        ToolTip="Build, link and run (F5)"
                        Padding="14,5"
                        Background="#388A34"
                        Foreground="White"
                        BorderThickness="0"
                        FontFamily="Consolas"
                        FontSize="13"
                        Cursor="Hand" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="150" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- File Explorer -->
            <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#3C3C3C" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#252526" Padding="8,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="File Explorer" FontWeight="SemiBold" Foreground="#CCCCCC" FontSize="12" />
                            <TextBlock x:Name="folderPathLabel" Foreground="#808080" FontSize="11" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Tree -->
                    <TreeView x:Name="fileTree"
                              Grid.Row="1"
                              Background="#1E1E1E"
                              Foreground="#CCCCCC"
                              BorderThickness="0"
                              Padding="4"
                              VirtualizingStackPanel.IsVirtualizing="True">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Foreground" Value="#CCCCCC" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="2,1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <StackPanel>
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter x:Name="PART_Header"
                                                                      ContentSource="Header"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                                <ItemsPresenter x:Name="ItemsHost"
                                                                Visibility="Collapsed"
                                                                Margin="18,0,0,0" />
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="True">
                                                    <Setter TargetName="ItemsHost"
                                                            Property="Visibility"
                                                            Value="Visible" />
                                                </Trigger>
                                                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd"
                                                            Property="Background"
                                                            Value="#2A2D2E" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd"
                                                            Property="Background"
                                                            Value="#37373D" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="1">
                                    <!-- Go gopher icon for .g / .go files -->
                                    <Viewbox x:Name="GopherIcon" Width="18" Height="18"
                                             Margin="1,0,5,0" Visibility="Collapsed">
                                        <Canvas Width="254.5" Height="225">
                                            <Path Fill="#2DBCAF" Data="M40.2,101.1c-0.4,0-0.5-0.2-0.3-0.5l2.1-2.7c0.2-0.3,0.7-0.5,1.1-0.5l35.7,0c0.4,0,0.5,0.3,0.3,0.6l-1.7,2.6c-0.2,0.3-0.7,0.6-1,0.6L40.2,101.1z"/>
                                            <Path Fill="#2DBCAF" Data="M25.1,110.3c-0.4,0-0.5-0.2-0.3-0.5l2.1-2.7c0.2-0.3,0.7-0.5,1.1-0.5l45.6,0c0.4,0,0.6,0.3,0.5,0.6l-0.8,2.4c-0.1,0.4-0.5,0.6-0.9,0.6L25.1,110.3z"/>
                                            <Path Fill="#2DBCAF" Data="M49.3,119.5c-0.4,0-0.5-0.3-0.3-0.6l1.4-2.5c0.2-0.3,0.6-0.6,1-0.6l20,0c0.4,0,0.6,0.3,0.6,0.7l-0.2,2.4c0,0.4-0.4,0.7-0.7,0.7L49.3,119.5z"/>
                                            <Path Fill="#2DBCAF" Data="M153.1,99.3c-6.3,1.6-10.6,2.8-16.8,4.4c-1.5,0.4-1.6,0.5-2.9-1c-1.5-1.7-2.6-2.8-4.7-3.8c-6.3-3.1-12.4-2.2-18.1,1.5c-6.8,4.4-10.3,10.9-10.2,19c0.1,8,5.6,14.6,13.5,15.7c6.8,0.9,12.5-1.5,17-6.6c0.9-1.1,1.7-2.3,2.7-3.7c-3.6,0-8.1,0-19.3,0c-2.1,0-2.6-1.3-1.9-3c1.3-3.1,3.7-8.3,5.1-10.9c0.3-0.6,1-1.6,2.5-1.6c5.1,0,23.9,0,36.4,0c-0.2,2.7-0.2,5.4-0.6,8.1c-1.1,7.2-3.8,13.8-8.2,19.6c-7.2,9.5-16.6,15.4-28.5,17c-9.8,1.3-18.9-0.6-26.9-6.6c-7.4-5.6-11.6-13-12.7-22.2c-1.3-10.9,1.9-20.7,8.5-29.3c7.1-9.3,16.5-15.2,28-17.3c9.4-1.7,18.4-0.6,26.5,4.9c5.3,3.5,9.1,8.3,11.6,14.1C154.7,98.5,154.3,99,153.1,99.3z"/>
                                            <Path Fill="#2DBCAF" Data="M186.2,154.6c-9.1-0.2-17.4-2.8-24.4-8.8c-5.9-5.1-9.6-11.6-10.8-19.3c-1.8-11.3,1.3-21.3,8.1-30.2c7.3-9.6,16.1-14.6,28-16.7c10.2-1.8,19.8-0.8,28.5,5.1c7.9,5.4,12.8,12.7,14.1,22.3c1.7,13.5-2.2,24.5-11.5,33.9c-6.6,6.7-14.7,10.9-24,12.8C191.5,154.2,188.8,154.3,186.2,154.6z M210,114.2c-0.1-1.3-0.1-2.3-0.3-3.3c-1.8-9.9-10.9-15.5-20.4-13.3c-9.3,2.1-15.3,8-17.5,17.4c-1.8,7.8,2,15.7,9.2,18.9c5.5,2.4,11,2.1,16.3-0.6C205.2,129.2,209.5,122.8,210,114.2z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <!-- Emoji icon for directories and non-Go files -->
                                    <TextBlock x:Name="ItemIcon"
                                               Text="{Binding IconText}"
                                               FontFamily="Segoe UI Emoji" FontSize="14"
                                               Foreground="#808080"
                                               Width="20" TextAlignment="Center"
                                               Margin="0,0,4,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="#CCCCCC"
                                               FontFamily="Consolas" FontSize="13"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                        <Setter TargetName="ItemIcon"
                                                Property="Foreground"
                                                Value="#DCB67A" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsGoFile}" Value="True">
                                        <Setter TargetName="GopherIcon"
                                                Property="Visibility"
                                                Value="Visible" />
                                        <Setter TargetName="ItemIcon"
                                                Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- Folder Control Buttons -->
                    <Border Grid.Row="2" Background="#252526" Padding="6,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="explorerOpenFolderButton"
                                    Content="📁 Open"
                                    Click="OnOpenFolderClick"
                                    Grid.Column="0"
                                    Height="36"
                                    FontSize="11"
                                    FontFamily="Consolas"
                                    Background="#007ACC"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="8,6"
                                    Margin="0,0,3,0"
                                    Visibility="Visible" />
                            <Button x:Name="explorerCloseFolderButton"
                                    Content="📁 Close"
                                    Click="OnCloseFolderClick"
                                    Grid.Column="1"
                                    Height="36"
                                    FontSize="11"
                                    FontFamily="Consolas"
                                    Background="#D13438"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="8,6"
                                    Margin="3,0,0,0"
                                    Visibility="Hidden" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#3C3C3C" />

            <!-- Editor Panel -->
            <Grid Grid.Column="2">
                <!--
                    Row layout:
                    0  TabBar         Auto
                    1  Editor         *        ← absorbs all leftover space
                    2  errorsPanel    130px    ← draggable top border resizes THIS row only
                    3  outputPanel    110px    ← draggable top border resizes THIS row only
                    4  StatusBar      Auto

                    Each panel is a Grid with:
                      Row 0 = drag handle (4px, SizeNS cursor) — MouseDown/Move in code-behind
                      Row 1 = Header (Auto, always visible)
                      Row 2 = Content (*, hidden when collapsed)
                -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="errorsPanelRow"  Height="130" MinHeight="0" />
                    <RowDefinition x:Name="outputPanelRow"  Height="110" MinHeight="0" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Tab/Title bar -->
                <Border Grid.Row="0" Background="#2D2D30" Padding="8,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="fileNameLabel"
                                   Text="No file open"
                                   Foreground="#9D9D9D"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="unsavedLabel"
                                   Text="unsaved changes"
                                   Foreground="#CE9178"
                                   FontFamily="Consolas"
                                   FontSize="10"
                                   FontStyle="Italic"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- AvalonEdit Editor -->
                <avalonedit:TextEditor x:Name="textEditor"
                                       Grid.Row="1"
                                       FontFamily="Consolas"
                                       FontSize="14"
                                       Foreground="#D4D4D4"
                                       Background="#1E1E1E"
                                       ShowLineNumbers="True"
                                       LineNumbersForeground="#858585"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto" />

                <!-- Welcome Overlay -->
                <Grid x:Name="welcomeOverlay"
                      Grid.Row="0"
                      Grid.RowSpan="5"
                      Background="#1E1E1E"
                      Visibility="Visible">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="MiniGo IDE"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="#CCCCCC" TextAlignment="Center"
                                   FontFamily="Consolas" Margin="0,0,0,10" />
                        <TextBlock Text="Open a folder to get started"
                                   FontSize="16" Foreground="#808080"
                                   TextAlignment="Center" FontFamily="Consolas"
                                   Margin="0,0,0,20" />
                        <Button x:Name="welcomeOpenFolderButton"
                                Content="📁 Open Folder" Click="OnOpenFolderClick"
                                Width="200" Height="50" FontSize="16"
                                FontFamily="Consolas" Background="#007ACC"
                                Foreground="White" BorderThickness="0"
                                Cursor="Hand" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- ═══ ERRORS PANEL ═══ -->
                <Grid Grid.Row="2" x:Name="errorsPanelGrid">
                    <Grid.RowDefinitions>
                        <!-- drag handle -->
                        <RowDefinition Height="4" />
                        <!-- header — always visible -->
                        <RowDefinition Height="Auto" />
                        <!-- content — collapses to 0 -->
                        <RowDefinition x:Name="errorsContentRow" Height="*" MinHeight="0" />
                    </Grid.RowDefinitions>

                    <!-- Drag handle: MouseDown starts resize of errorsPanelRow -->
                    <Border Grid.Row="0"
                            x:Name="errorsDragHandle"
                            Background="#3C3C3C"
                            Cursor="SizeNS"
                            MouseDown="OnErrorsDragHandleMouseDown"
                            MouseMove="OnErrorsDragHandleMouseMove"
                            MouseUp="OnErrorsDragHandleMouseUp" />

                    <!-- Errors Header -->
                    <Border Grid.Row="1" Background="#252526" Padding="6,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Errors"
                                       Foreground="#9D9D9D" FontFamily="Consolas"
                                       FontSize="11" VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    x:Name="toggleErrorListButton"
                                    Content="▼" Click="OnToggleErrorListClick"
                                    Width="24" Height="24"
                                    Background="#2D2D30" Foreground="#CCCCCC"
                                    BorderThickness="1" BorderBrush="#3C3C3C"
                                    FontFamily="Consolas" FontSize="12"
                                    Cursor="Hand" Padding="0" />
                        </Grid>
                    </Border>

                    <!-- Errors Content -->
                    <DataGrid Grid.Row="2"
                              x:Name="errorList"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              Background="#1E1E1E"
                              Foreground="#D4D4D4"
                              RowBackground="#1E1E1E"
                              AlternatingRowBackground="#252526"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              ColumnHeaderHeight="24"
                              RowHeight="22"
                              FontFamily="Consolas"
                              FontSize="12"
                              MouseDoubleClick="OnErrorListDoubleClick">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"      Value="#2D2D30" />
                                <Setter Property="Foreground"      Value="#CCCCCC" />
                                <Setter Property="Padding"         Value="6,0" />
                                <Setter Property="BorderBrush"     Value="#3C3C3C" />
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sev"     Binding="{Binding Severity}" Width="45" />
                            <DataGridTextColumn Header="Line"    Binding="{Binding Line}"     Width="50" />
                            <DataGridTextColumn Header="Col"     Binding="{Binding Column}"   Width="50" />
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}"  Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ═══ OUTPUT PANEL ═══ -->
                <Grid Grid.Row="3" x:Name="outputPanelGrid">
                    <Grid.RowDefinitions>
                        <!-- drag handle -->
                        <RowDefinition Height="4" />
                        <!-- header — always visible -->
                        <RowDefinition Height="Auto" />
                        <!-- content — collapses to 0 -->
                        <RowDefinition x:Name="outputContentRow" Height="*" MinHeight="0" />
                    </Grid.RowDefinitions>

                    <!-- Drag handle: MouseDown starts resize of outputPanelRow -->
                    <Border Grid.Row="0"
                            x:Name="outputDragHandle"
                            Background="#3C3C3C"
                            Cursor="SizeNS"
                            MouseDown="OnOutputDragHandleMouseDown"
                            MouseMove="OnOutputDragHandleMouseMove"
                            MouseUp="OnOutputDragHandleMouseUp" />

                    <!-- Output Header -->
                    <Border Grid.Row="1" Background="#252526" Padding="6,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Output"
                                       Foreground="#9D9D9D" FontFamily="Consolas"
                                       FontSize="11" VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    x:Name="toggleOutputButton"
                                    Content="▼" Click="OnToggleOutputClick"
                                    Width="24" Height="24"
                                    Background="#2D2D30" Foreground="#CCCCCC"
                                    BorderThickness="1" BorderBrush="#3C3C3C"
                                    FontFamily="Consolas" FontSize="12"
                                    Cursor="Hand" Padding="0" />
                        </Grid>
                    </Border>

                    <!-- Output Content -->
                    <RichTextBox Grid.Row="2"
                             x:Name="outputPanel"
                             IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12"
                             Background="#0C0C0C"
                             BorderThickness="0" Padding="6,4"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </Grid>

                <!-- Status Bar -->
                <Border Grid.Row="4" Background="#007ACC" Padding="8,4">
                    <TextBlock x:Name="statusLabel"
                               Text="Ready" Foreground="White" FontSize="11" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>