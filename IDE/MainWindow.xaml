<Window x:Class="IDE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:IDE"
        mc:Ignorable="d"
        Title="MiniGo IDE" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="F6" Command="{x:Static local:MainWindow.BuildCommand}" />
        <KeyBinding Key="F5" Command="{x:Static local:MainWindow.RunCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <Style TargetType="TreeViewItem">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="#2D2D30" Foreground="#CCCCCC">
            <MenuItem Header="_File" Foreground="#CCCCCC">
                <MenuItem Header="_Open Folder..." Click="OnOpenFolderClick" InputGestureText="Ctrl+Shift+O" Foreground="#000000" Background="#FFFFFF" />
                <MenuItem x:Name="menuCloseFolder" Header="_Close Folder" Click="OnCloseFolderClick" IsEnabled="False" Foreground="#000000" Background="#FFFFFF" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClick" Foreground="#000000" Background="#FFFFFF" />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="#2D2D30" BorderBrush="#3C3C3C" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Horizontal" Margin="6,4">
                <Button x:Name="buildButton"
                        Content="⚙ Build"
                        Click="OnBuildClick"
                        ToolTip="Build current file (F6)"
                        Padding="14,5"
                        Margin="0,0,6,0"
                        Background="#0E639C"
                        Foreground="White"
                        BorderThickness="0"
                        FontFamily="Consolas"
                        FontSize="13"
                        Cursor="Hand" />
                <Button x:Name="stopButton"
                        Content="⏹ Stop"
                        Click="OnStopClick"
                        ToolTip="Stop current build"
                        Padding="14,5"
                        Margin="0,0,6,0"
                        Background="#D13438"
                        Foreground="White"
                        BorderThickness="0"
                        FontFamily="Consolas"
                        FontSize="13"
                        Cursor="Hand"
                        IsEnabled="False"
                        Visibility="Hidden" />
                <Button x:Name="runButton"
                        Content="▶ Run"
                        Click="OnRunClick"
                        ToolTip="Run generated .ll file (F5)"
                        Padding="14,5"
                        Background="#388A34"
                        Foreground="White"
                        BorderThickness="0"
                        FontFamily="Consolas"
                        FontSize="13"
                        Cursor="Hand" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="150" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- File Explorer -->
            <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#3C3C3C" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#252526" Padding="8,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="File Explorer" FontWeight="SemiBold" Foreground="#CCCCCC" FontSize="12" />
                            <TextBlock x:Name="folderPathLabel" Foreground="#808080" FontSize="11" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Tree -->
                    <TreeView x:Name="fileTree"
                              Grid.Row="1"
                              Background="#1E1E1E"
                              Foreground="#CCCCCC"
                              BorderThickness="0"
                              Padding="4"
                              VirtualizingStackPanel.IsVirtualizing="True">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Foreground" Value="#CCCCCC" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="1">
                                    <TextBlock Text="{Binding Name}" Foreground="#CCCCCC" FontFamily="Consolas"
                                               FontSize="13" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- Folder Control Buttons -->
                    <Border Grid.Row="2" Background="#252526" Padding="6,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="explorerOpenFolderButton"
                                    Content="📁 Open"
                                    Click="OnOpenFolderClick"
                                    Grid.Column="0"
                                    Height="36"
                                    FontSize="11"
                                    FontFamily="Consolas"
                                    Background="#007ACC"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="8,6"
                                    Margin="0,0,3,0"
                                    Visibility="Visible" />
                            <Button x:Name="explorerCloseFolderButton"
                                    Content="📁 Close"
                                    Click="OnCloseFolderClick"
                                    Grid.Column="1"
                                    Height="36"
                                    FontSize="11"
                                    FontFamily="Consolas"
                                    Background="#D13438"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="8,6"
                                    Margin="3,0,0,0"
                                    Visibility="Hidden" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#3C3C3C" />

            <!-- Editor Panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="mainSplitterRow" Height="4" />
                    <RowDefinition x:Name="bottomPanelRow" Height="250" MinHeight="60" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Tab/Title bar -->
                <Border Grid.Row="0" Background="#2D2D30" Padding="8,4">
                    <TextBlock x:Name="fileNameLabel"
                               Text="No file open"
                               Foreground="#9D9D9D"
                               FontFamily="Consolas"
                               FontSize="12" />
                </Border>

                <!-- AvalonEdit Editor -->
                <avalonedit:TextEditor x:Name="textEditor"
                                       Grid.Row="1"
                                       FontFamily="Consolas"
                                       FontSize="14"
                                       Foreground="#D4D4D4"
                                       Background="#1E1E1E"
                                       ShowLineNumbers="True"
                                       LineNumbersForeground="#858585"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto" />

                <!-- Welcome Overlay (shown when no folder is open) -->
                <Grid x:Name="welcomeOverlay"
                      Grid.Row="0"
                      Grid.RowSpan="5"
                      Background="#1E1E1E"
                      Visibility="Visible">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="MiniGo IDE"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#CCCCCC"
                                   TextAlignment="Center"
                                   FontFamily="Consolas"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="Open a folder to get started"
                                   FontSize="16"
                                   Foreground="#808080"
                                   TextAlignment="Center"
                                   FontFamily="Consolas"
                                   Margin="0,0,0,20" />
                        <Button x:Name="welcomeOpenFolderButton"
                                Content="📁 Open Folder"
                                Click="OnOpenFolderClick"
                                Width="200"
                                Height="50"
                                FontSize="16"
                                FontFamily="Consolas"
                                Background="#007ACC"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Splitter between editor and bottom panels container -->
                <GridSplitter Grid.Row="2"
                              Height="4"
                              HorizontalAlignment="Stretch"
                              Background="#3C3C3C"
                              ResizeDirection="Rows"
                              x:Name="mainSplitter" />

                <!-- Bottom Panels Container (Error List + Output Panel) -->
                <Grid Grid.Row="3" x:Name="bottomPanelsContainer">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="32" x:Name="errorListRow" />
                        <RowDefinition Height="4" x:Name="errorOutputSplitterRow" />
                        <RowDefinition Height="*" MinHeight="28" x:Name="outputRow" />
                    </Grid.RowDefinitions>

                        <!-- Error List Panel Container -->
                        <Grid Grid.Row="0" x:Name="errorListPanelContainer">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="*" x:Name="errorListContentRow" />
                            </Grid.RowDefinitions>

                            <!-- Error List Header Bar -->
                            <Border Grid.Row="0" Background="#252526" Padding="6,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Errors"
                                               Foreground="#9D9D9D"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            x:Name="toggleErrorListButton"
                                            Content="▼"
                                            Click="OnToggleErrorListClick"
                                            Width="24"
                                            Height="24"
                                            Background="#2D2D30"
                                            Foreground="#CCCCCC"
                                            BorderThickness="1"
                                            BorderBrush="#3C3C3C"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Cursor="Hand"
                                            Padding="0" />
                                </Grid>
                            </Border>

                            <!-- Error List DataGrid -->
                            <DataGrid Grid.Row="1"
                                      x:Name="errorList"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      HeadersVisibility="Column"
                                      Background="#1E1E1E"
                                      Foreground="#D4D4D4"
                                      RowBackground="#1E1E1E"
                                      AlternatingRowBackground="#252526"
                                      GridLinesVisibility="None"
                                      BorderThickness="0"
                                      ColumnHeaderHeight="24"
                                      RowHeight="22"
                                      FontFamily="Consolas"
                                      FontSize="12"
                                      MouseDoubleClick="OnErrorListDoubleClick">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background"   Value="#2D2D30" />
                                        <Setter Property="Foreground"   Value="#CCCCCC" />
                                        <Setter Property="Padding"      Value="6,0" />
                                        <Setter Property="BorderBrush"  Value="#3C3C3C" />
                                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Sev"     Binding="{Binding Severity}" Width="45" />
                                    <DataGridTextColumn Header="Line"    Binding="{Binding Line}"     Width="50" />
                                    <DataGridTextColumn Header="Col"     Binding="{Binding Column}"   Width="50" />
                                    <DataGridTextColumn Header="Message" Binding="{Binding Message}"  Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- Splitter between error list and output panel -->
                        <GridSplitter Grid.Row="1"
                                      Height="4"
                                      HorizontalAlignment="Stretch"
                                      Background="#3C3C3C"
                                      ResizeDirection="Rows"
                                      x:Name="errorOutputSplitter" />

                        <!-- Output Panel Container -->
                        <Grid Grid.Row="2" x:Name="outputPanelContainer">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="*" x:Name="outputContentRow" />
                            </Grid.RowDefinitions>

                            <!-- Output Header with Collapse Button -->
                            <Border Grid.Row="0" Background="#252526" Padding="6,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Output"
                                               Foreground="#9D9D9D"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            x:Name="toggleOutputButton"
                                            Content="▼"
                                            Click="OnToggleOutputClick"
                                            Width="24"
                                            Height="24"
                                            Background="#2D2D30"
                                            Foreground="#CCCCCC"
                                            BorderThickness="1"
                                            BorderBrush="#3C3C3C"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Cursor="Hand"
                                            Padding="0" />
                                </Grid>
                            </Border>

                            <!-- Output TextBox -->
                            <TextBox Grid.Row="1"
                                     x:Name="outputPanel"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Background="#0C0C0C"
                                     Foreground="#CCCCCC"
                                     BorderThickness="0"
                                     Padding="6,4"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" />
                        </Grid>
                </Grid>

                <!-- Status Bar -->
                <Border Grid.Row="4" Background="#007ACC" Padding="8,4">
                    <TextBlock x:Name="statusLabel"
                               Text="Ready"
                               Foreground="White"
                               FontSize="11" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>