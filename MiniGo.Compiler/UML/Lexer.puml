' ============================================================
' PACKAGE: Error Handling (hand-written)
' ============================================================
package "Errors/\n(hand-written)" #FFEBEE {
    enum "Severity" as Severity {
        Error
        Warning
    }
    class "SourceSpan\n<<struct>>" as SourceSpan {
        + FilePath : string
        + Line : int (1-based)
        + Column : int (0-based)
        + Length : int
        --
        + FromToken(IToken) : SourceSpan
        + FromCharPosition(l,c,len) : SourceSpan
    }
    class "CompilationError\n<<sealed>>" as CompilationError {
        + Severity : Severity
        + Message : string
        + Span : SourceSpan
        + Phase : string
    }
    class "ErrorCollector\n<<sealed>>" as ErrorCollector {
        - _errors : List<CompilationError>
        - _filePath : string
        --
        + AddLexerError(msg, line, col)
        + AddParserError(msg, token)
        + HasErrors : bool
        + Report(writer)
    }
    class "LexerErrorListener\n<<sealed>>" as LexerErrorListener {
        + SyntaxError(..., offendingSymbol: int, ...)
    }
    class "ParserErrorListener\n<<sealed>>" as ParserErrorListener {
        + SyntaxError(..., offendingSymbol: IToken, ...)
    }
'    class "MiniGoErrorStrategy\n<<sealed>>" as ErrorStrategy {
'        delimiter-based panic mode
'    }
    interface "IAntlrErrorListener\\n<int>" as ILexerErrI
    interface "IAntlrErrorListener\\n<IToken>" as IParserErrI
'    abstract class "DefaultErrorStrategy" as DefaultErrorStrat

    LexerErrorListener .|> ILexerErrI
    ParserErrorListener .|> IParserErrI
'    ErrorStrategy -|> DefaultErrorStrat
    ErrorCollector *-- CompilationError
    CompilationError *-- SourceSpan
    CompilationError *-- Severity
    LexerErrorListener --> ErrorCollector : delegates to
    ParserErrorListener --> ErrorCollector : delegates to
}

' ============================================================
' RELATIONSHIPS — Source Code Flow
' ============================================================

' Input chain
'Main --> CharStreams : "1. File.ReadAllText()"
'Main --> MiniGoLexerGen : "2. new MiniGoLexer(stream)"
'Main --> TokenStream : "3. new CommonTokenStream(lexer)"
'Main --> MiniGoParserGen : "4. new MiniGoParser(tokens)"

' Error listener wiring
Main --> LexerErrorListener : "5. AddErrorListener()"
Main --> ParserErrorListener : "6. AddErrorListener()"
'Main --> ErrorStrategy : "7. ErrorHandler ="

' Final invocation
Main --> MiniGoParserGen : "8. parser.root()"

' Grammar → generated code
LexerG4 ..> MiniGoLexerGen : ANTLR generates
ParserG4 ..> MiniGoParserGen : ANTLR generates
ParserG4 ..> LexerG4 : tokenVocab

' Token stream bridge
TokenStream --> MiniGoLexerGen : wraps & pulls tokens
MiniGoParserGen --> TokenStream : reads from

' ============================================================
' BOUNDARY: Lexer → Parser handoff
' ============================================================
note as HandoffNote #C8E6C9
    <b>↑ OUTPUT from Lexer Phase</b>
    CommonTokenStream<IToken>
    (buffered sequence of 73 token types,
     WS/comments on HIDDEN channel)
    
    <b>↓ INPUT to Parser Phase</b>
    MiniGoParser consumes token stream
    via rule entry methods (root(), etc.)
end note

TokenStream .. HandoffNote
HandoffNote .. MiniGoParserGen

' ============================================================
' LEGEND
' ============================================================
legend bottom
    |= Color |= Meaning |
    | <#E3F2FD> | Orchestration (Program.cs) |
    | <#E8F5E9> | Grammar definitions (.g4) |
    | <#FFF3E0> | ANTLR Runtime (NuGet) |
    | <#F3E5F5> | Generated code (.gitignored) |
    | <#FFEBEE> | Hand-written error handling |
endlegend

@enduml
