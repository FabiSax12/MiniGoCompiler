@startuml Lexer
' ============================================================
' MiniGo Compiler — Lexer/Scanner Architecture
' Source code input → token stream output to parser
' ============================================================

skinparam packageStyle rectangle
skinparam classBackgroundColor #F0F4F8
skinparam packageBackgroundColor #E8ECF0
skinparam noteBackgroundColor #FFFDE7
skinparam arrowColor #37474F
skinparam defaultFontSize 12

title MiniGo Compiler — Lexer / Scanner Architecture\n

' ============================================================
' PACKAGE: Orchestration — Program.cs
' ============================================================
package "Program.cs\n(Orchestration)" #E3F2FD {
    class "Main()" as Main <<entrypoint>> {
    }
}

note bottom of Main
    <b>Pipeline:</b>
    1. File.ReadAllText → string source
    2. CharStreams.fromString → ICharStream
    3. new MiniGoLexer(stream)
    4. Attach LexerErrorListener
    5. new CommonTokenStream(lexer)
    6. new MiniGoParser(tokens)
    7. Attach ParserErrorListener
    8. parser.root() → RootContext
end note

